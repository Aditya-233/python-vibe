# Copy to .env for local overrides. Never commit .env.
# Tests and CI do not need any of these.

# Ollama chat API (default is local).
# OLLAMA_HOST=http://127.0.0.1:11434

# scripts/serve.py — keep 127.0.0.1 unless you accept LAN clients.
# HARNESS_HOST=127.0.0.1
# HARNESS_PORT=8080

# Everyday agent / Cursor brain (not the 0.5B sidecar).
# OLLAMA_MODEL=llama3.1:8b

# scripts/openai_compat.py
# OPENAI_COMPAT_HOST=127.0.0.1
# OPENAI_COMPAT_PORT=8081

# Push adapters to YOUR namespace. Never implied as the official account.
# HF_USER=
# HF_REPO=
# HF_TOKEN=
